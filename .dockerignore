# data/
# models/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Database (if using volume mount)
# database/*.db

# Temporary files
tmp/
temp/
*.tmp

# Test files
tests/
test/
pytest.ini

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Docker files themselves (optional - remove if you want them in context)
# Dockerfile
# docker-compose.yml
# .dockerignore

# NOTE: This is a template .dockerignore file.
