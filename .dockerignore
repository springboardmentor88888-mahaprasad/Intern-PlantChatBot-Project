# PlantDocBot — .dockerignore
# Excludes unnecessary files from the Docker build context

# Virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.egg-info/

# IDE
.vscode/
.idea/
*.swp

# Git
.git/
.gitignore

# Secrets (injected via env_file or env vars, never baked in)
.env

# Notebooks & training data
*.ipynb
.ipynb_checkpoints/
testing_data/
train*/

# Model files (auto-downloaded at runtime from HuggingFace)
models/*.pth

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Docker files themselves
docker-compose.yml
.dockerignore
