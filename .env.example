# ============================================================================
# PlantDocBot — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================================

# --- Required ---
GROQ_API_KEY=gsk_your_api_key_here

# --- Model (optional overrides) ---
# MODEL_FILENAME=efficientnetv2s.pth
# MODEL_ARCH=tf_efficientnetv2_s
# IMG_SIZE=224
# HF_REPO_ID=sayandip05/plantdocbot-efficientnetv2s

# --- Confidence thresholds ---
# CONFIDENCE_LOW=0.6
# CONFIDENCE_HIGH=0.8
# CONFIDENCE_MODERATE=0.4

# --- Groq LLM ---
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FALLBACK_MODEL=llama3-70b-8192

# --- Whisper ---
# WHISPER_MODEL_SIZE=tiny

# --- API server ---
# API_HOST=0.0.0.0
# API_PORT=5000

# --- Not-a-Plant class name ---
# NOT_A_PLANT_CLASS=Not_a_Plant
